<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCompras.Views.RelatorioCategoria"
             Title="RELATÓRIO POR CATEGORIA">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Valor gasto por Categoria"
                FontSize="23"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="lista_relatorio">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="2">

                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Categoria}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding TotalFormatado}"
                                    FontSize="18" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                x:Name="label_total"
                FontSize="22"
                FontAttributes="Bold" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>